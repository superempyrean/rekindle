{
  "name": "friend-notifications",
  "version": "0.1.0",
  "description": "A desktop notification when a friend comes online, for every friend or the ones you pick.",
  "private": true,
  "type": "module",
  "rekindle": {
    "id": "dev.rekindle.friend-notifications",
    "name": "Friend Notifications",
    "capabilities": [
      "read-client",
      "read-users",
      "notifications"
    ],
    "settings": [
      {
        "key": "only",
        "type": "users",
        "label": "Only these friends (none: every friend)"
      },
      {
        "key": "offline",
        "type": "toggle",
        "label": "Also when they go offline",
        "default": false
      }
    ]
  },
  "scripts": {
    "build": "rekindle build",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.41.0",
    "typescript": "7.0.2"
  }
}
