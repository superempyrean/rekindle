  "type": "module",
  "rekindle": {
    "id": "dev.rekindle.permissions-viewer",
    "name": "Permissions Viewer",
    "capabilities": ["ui", "read-client", "read-users"]
  },
  "scripts": {
    "build": "rekindle build",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.41.0",
    "typescript": "7.0.2"
  }
}
